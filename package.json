  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:product-zone": "node dist/src/main",
    "start:develop-zone": "yarn run seed && node dist/src/main",
    "start:migrate:product-zone": "prisma migrate deploy && yarn run seed && yarn run start:product-zone",
    "start:migrate:develop-zone": "prisma migrate deploy && yarn run start:develop-zone",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --config jest.config.js",
    "test:cov": "jest --config jest.config.js --coverage",
    "test:e2e": "jest --config test/jest-e2e.json",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "seed": "tsc prisma/seed.ts --outDir dist/prisma && node dist/prisma/seed.js",
    "pre-commit": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepare": "husky install",
    "db:reset": "prisma migrate reset --force && prisma generate && prisma studio"
  },
