              "host": ["{{baseUrl}}"],
              "path": ["wallet", "0xaa18f00e63efea1de8b18308bf74b740811b3c0f", "thb-balance"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
