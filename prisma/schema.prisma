// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Point {
  id              String        @id @default(cuid())
  name            String
  symbol          String
  contractAddress Bytes
  initialSupply   Int
  decimal         Int
  frameSize       Int
  slotSize        Int
  createdAt       DateTime      @default(now()) @map(name: "created_at")
  updatedAt       DateTime      @updatedAt @map(name: "updated_at")
  merchant        Merchant?     @relation(fields: [merchantId], references: [id])
  merchantId      String?
  transaction     Transaction[]
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  password     String
  createdAt    DateTime       @default(now()) @map(name: "created_at")
  updatedAt    DateTime       @updatedAt @map(name: "updated_at")
  userMerchant UserMerchant[]
  session      Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
}

model UserMerchant {
  id String @id @default(cuid())

  user       User?     @relation(fields: [userId], references: [id])
  userId     String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  merchantId String?
}

model Merchant {
  id               String             @id @default(cuid())
  name             String
  website          String
  createdAt        DateTime           @default(now()) @map(name: "created_at")
  updatedAt        DateTime           @updatedAt @map(name: "updated_at")
  userMerchant     UserMerchant[]
  branch           Branch[]
  point            Point[]
  apiKey           ApiKey[]
  transaction      Transaction[]
  customerMerChant CustomerMerChant[]
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String?
  description String?
  apiKey      String    @unique
  merchantId  String?
  createdAt   DateTime  @default(now()) @map(name: "created_at")
  updatedAt   DateTime  @updatedAt @map(name: "updated_at")
  merchant    Merchant? @relation(fields: [merchantId], references: [id])
}

model Branch {
  id         String    @id @default(cuid())
  email      String
  addr1      String
  addr2      String?
  city       String
  state      String
  zip        String
  createdAt  DateTime  @default(now()) @map(name: "created_at")
  updatedAt  DateTime  @updatedAt @map(name: "updated_at")
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  merchantId String?
}

model Transaction {
  id                String           @id @default(cuid())
  firstName         String?
  lastName          String?
  txHash            Bytes
  senderAddress     Bytes
  receiverAddress   Bytes
  amount            Int
  createdAt         DateTime         @default(now()) @map(name: "created_at")
  updatedAt         DateTime         @updatedAt @map(name: "updated_at")
  merchant          Merchant?        @relation(fields: [merchantId], references: [id])
  merchantId        String?
  point             Point?           @relation(fields: [pointId], references: [id])
  pointId           String?
  transactionType   TransactionType? @relation(fields: [transactionTypeId], references: [id])
  transactionTypeId String?
  customer          Customer?        @relation(fields: [customerId], references: [id])
  customerId        String?
}

model Customer {
  id               String             @id @default(cuid())
  email            String
  firstName        String?
  lastName         String?
  tel              String?
  walletAddress    Bytes
  privateKey       String //TODO: move to key vault
  createdAt        DateTime           @default(now()) @map(name: "created_at")
  updatedAt        DateTime           @updatedAt @map(name: "updated_at")
  customerMerChant CustomerMerChant[]
  transaction      Transaction[]
}

model CustomerMerChant {
  id         String    @id @default(cuid())
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id])
  merchantId String?
}

model TransactionType {
  id          String        @id @unique
  name        String
  description String
  transaction Transaction[]
}
