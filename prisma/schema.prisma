generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id          String    @id
  name        String?
  description String?
  apiKey      String    @unique
  merchantId  String?
  created_at  DateTime  @default(now())
  updated_at  DateTime
  Merchant    Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model Customer {
  id                                           String             @id
  email                                        String
  firstName                                    String?
  lastName                                     String?
  tel                                          String             @unique
  created_at                                   DateTime           @default(now())
  updated_at                                   DateTime
  walletId                                     String?            @unique
  Wallet                                       Wallet?            @relation(fields: [walletId], references: [id])
  CustomerMerChant                             CustomerMerChant[]
  CustomerPoint                                CustomerPoint[]
  Transaction_Transaction_receiverIdToCustomer Transaction[]      @relation("Transaction_receiverIdToCustomer")
  Transaction_Transaction_senderIdToCustomer   Transaction[]      @relation("Transaction_senderIdToCustomer")
  VoucherCode                                  VoucherCode[]
}

model CustomerMerChant {
  id         String    @id
  customerId String?
  merchantId String?
  Customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model CustomerPoint {
  id         String    @id
  customerId String?
  pointId    String?
  balances   Int       @default(0)
  Customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Point      Point?    @relation(fields: [pointId], references: [id], onDelete: Cascade)

  @@unique([customerId, pointId])
}

model ListingBatch {
  id                  String             @id
  sellerWalletAddress String
  name                String?
  description         String?
  totalItems          Int
  soldItems           Int                @default(0)
  totalValue          Float
  currency            String             @default("THB")
  status              ListingBatchStatus @default(ACTIVE)
  created_at          DateTime           @default(now())
  updated_at          DateTime
  VoucherCode         VoucherCode[]

  @@index([created_at])
  @@index([sellerWalletAddress])
  @@index([status])
}

model Merchant {
  id                                                   String             @id
  name                                                 String
  website                                              String
  created_at                                           DateTime           @default(now())
  updated_at                                           DateTime
  description                                          String?
  imageUrl                                             String?
  location                                             String?
  points                                               Int                @default(0)
  voucherIds                                           String[]           @default([])
  tel                                                  String
  walletId                                             String?            @unique
  ApiKey                                               ApiKey[]
  CustomerMerChant                                     CustomerMerChant[]
  Wallet                                               Wallet?            @relation(fields: [walletId], references: [id])
  Point                                                Point[]
  Transaction_Transaction_merchantIdToMerchant         Transaction[]      @relation("Transaction_merchantIdToMerchant")
  Transaction_Transaction_merchantReceiverIdToMerchant Transaction[]      @relation("Transaction_merchantReceiverIdToMerchant")
  Transaction_Transaction_merchantSenderIdToMerchant   Transaction[]      @relation("Transaction_merchantSenderIdToMerchant")
  UserMerchant                                         UserMerchant[]
  Voucher                                              Voucher[]
}

model Point {
  id              String          @id
  name            String
  symbol          String
  contractAddress Bytes
  initialSupply   Int
  decimal         Int
  created_at      DateTime        @default(now())
  updated_at      DateTime
  merchantId      String?
  imageUrl        String?
  startDate       DateTime?
  endDate         DateTime
  epochDuration   Int             @default(259200)
  CustomerPoint   CustomerPoint[]
  Merchant        Merchant?       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  Transaction     Transaction[]
  VoucherCode     VoucherCode[]
}

model Session {
  id         String   @id
  token      String
  created_at DateTime @default(now())
  updated_at DateTime
  userId     String?
  User       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TempLinkCreateUser {
  id          String   @id
  uid         String   @unique
  expire      DateTime
  phoneNumber String
  merchantId  String
  created_at  DateTime @default(now())
  updated_at  DateTime
  otp         String?

  @@index([expire])
  @@index([merchantId])
  @@index([phoneNumber])
  @@index([uid])
}

model Transaction {
  id                                                String           @id
  txHash                                            Bytes
  senderAddress                                     Bytes
  receiverAddress                                   Bytes
  amount                                            Int
  created_at                                        DateTime         @default(now())
  updated_at                                        DateTime
  merchantId                                        String?
  pointId                                           String?
  transactionTypeId                                 String?
  senderId                                          String?
  receiverId                                        String?
  voucherCodeId                                     String?
  eventId                                           String?
  merchantSenderId                                  String?
  merchantReceiverId                                String?
  type                                              AssetType?
  transactionRefId                                  String?
  merchantRef                                       String?
  receiverType                                      ParticipantType?
  senderType                                        ParticipantType?
  Merchant_Transaction_merchantIdToMerchant         Merchant?        @relation("Transaction_merchantIdToMerchant", fields: [merchantId], references: [id], onDelete: Cascade)
  Merchant_Transaction_merchantReceiverIdToMerchant Merchant?        @relation("Transaction_merchantReceiverIdToMerchant", fields: [merchantReceiverId], references: [id], onDelete: Cascade)
  Merchant_Transaction_merchantSenderIdToMerchant   Merchant?        @relation("Transaction_merchantSenderIdToMerchant", fields: [merchantSenderId], references: [id], onDelete: Cascade)
  Point                                             Point?           @relation(fields: [pointId], references: [id], onDelete: Cascade)
  Customer_Transaction_receiverIdToCustomer         Customer?        @relation("Transaction_receiverIdToCustomer", fields: [receiverId], references: [id], onDelete: Cascade)
  Customer_Transaction_senderIdToCustomer           Customer?        @relation("Transaction_senderIdToCustomer", fields: [senderId], references: [id], onDelete: Cascade)
  TransactionType                                   TransactionType? @relation(fields: [transactionTypeId], references: [id])
  VoucherCode                                       VoucherCode?     @relation(fields: [voucherCodeId], references: [id])

  @@index([eventId])
  @@index([receiverType])
  @@index([senderType])
  @@index([transactionRefId])
  @@index([type])
  @@index([voucherCodeId])
}

model TransactionType {
  id          String        @id @unique
  name        String
  description String
  Transaction Transaction[]
}

model Treasury {
  id            String   @id
  walletAddress String   @unique
  type          String   @unique
  created_at    DateTime @default(now())
  updated_at    DateTime
}

model User {
  id           String         @id
  email        String         @unique
  password     String
  created_at   DateTime       @default(now())
  updated_at   DateTime
  Session      Session[]
  UserMerchant UserMerchant[]
}

model UserMerchant {
  id         String    @id
  userId     String?
  merchantId String?
  Merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  User       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Voucher {
  id             String           @id
  name           String
  description    String
  status         VoucherStatus
  merchantName   String
  merchantId     String?
  valueType      VoucherValueType
  value          Float
  currency       String?
  startDate      DateTime
  endDate        DateTime
  totalIssued    Int
  totalRedeemed  Int
  imageUrl       String?
  limitPerMember Int?
  created_at     DateTime         @default(now())
  updated_at     DateTime
  tokenId        String?          @unique
  merchantRef    String?
  Merchant       Merchant?        @relation(fields: [merchantId], references: [id])
  VoucherCode    VoucherCode[]
}

model VoucherCode {
  id             String        @id
  code           String        @unique
  voucherId      String
  isUsed         Boolean       @default(false)
  usedBy         String?
  usedAt         DateTime?
  created_at     DateTime      @default(now())
  pointsCost     Int
  voucherGroupId String?
  currentOwnerId String?
  currency       String?
  pointId        String?
  listingBatchId String?
  Transaction    Transaction[]
  Customer       Customer?     @relation(fields: [currentOwnerId], references: [id])
  ListingBatch   ListingBatch? @relation(fields: [listingBatchId], references: [id])
  Point          Point?        @relation(fields: [pointId], references: [id])
  Voucher        Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  @@index([code])
  @@index([currentOwnerId, isUsed])
  @@index([listingBatchId])
  @@index([pointId])
  @@index([voucherGroupId])
  @@index([voucherId, isUsed])
}

model Wallet {
  id            String    @id
  privateKey    String
  email         String
  phoneNumber   String
  type          String
  status        String
  walletAddress String    @unique
  Customer      Customer?
  Merchant      Merchant?
}

enum AssetType {
  POINT
  VOUCHER
}

enum ListingBatchStatus {
  ACTIVE
  SOLD_OUT
  CANCELLED
  EXPIRED
}

enum ParticipantType {
  CUSTOMER
  MERCHANT
  SYSTEM
}

enum VoucherStatus {
  active
  upcoming
}

enum VoucherValueType {
  percentage
  cash
  gift
  multiplier
  aispoint
}
