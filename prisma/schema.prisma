// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Point {
  id              String          @id @default(cuid())
  name            String
  symbol          String
  contractAddress Bytes
  initialSupply   Int
  decimal         Int
  startDate       DateTime?       // วันเริ่มต้น (optional)
  endDate         DateTime        // วันหมดอายุ (required)
  epochDuration   Int             @default(259200) // ระยะเวลา 1 epoch (seconds) - default 3 วัน, แต่ configurable
  imageUrl        String?
  createdAt       DateTime        @default(now()) @map(name: "created_at")
  updatedAt       DateTime        @updatedAt @map(name: "updated_at")
  merchant        Merchant?       @relation(fields: [merchantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  merchantId      String?
  transactions    Transaction[]
  customerPoints  CustomerPoint[]
  voucherCodes    VoucherCode[] // ← Voucher codes that use this point currency
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  password             String
  walletId             String?        @unique // Master wallet
  wallet               Wallet?        @relation(fields: [walletId], references: [id])
  nextDerivationIndex  Int            @default(1) // Next index to use for merchant/seller derivation
  createdAt            DateTime       @default(now()) @map(name: "created_at")
  updatedAt            DateTime       @updatedAt @map(name: "updated_at")
  userMerchant         UserMerchant[]
  session              Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String
  createdAt DateTime @default(now()) @map(name: "created_at")
  updatedAt DateTime @updatedAt @map(name: "updated_at")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId    String?
}

model UserMerchant {
  id String @id @default(cuid())

  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId     String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  merchantId String?
}

model Wallet {
  id              String    @id @default(cuid())
  walletAddress   String    @unique
  seedPhrase      String    // encrypted mnemonic phrase
  chainCode       String    // encrypted chain code for HD derivation
  derivationIndex Int       @default(0) // BIP44 derivation index
  email           String
  phoneNumber     String
  type            String    // 'master', 'merchant', 'seller', 'customer'
  status          String
  // relations
  customer        Customer?
  merchant        Merchant?
  user            User?     // Master wallet owner
}

model Merchant {
  id               String             @id @default(cuid())
  name             String
  description      String?
  imageUrl         String?
  points           Int                @default(0)
  location         String?
  website          String
  voucherIds       String[]           @default([])
  createdAt        DateTime           @default(now()) @map(name: "created_at")
  updatedAt        DateTime           @updatedAt @map(name: "updated_at")
  userMerchant     UserMerchant[]
  point            Point[]
  apiKey           ApiKey[]
  transactions     Transaction[]      @relation("TransactionMerchant")
  customerMerChant CustomerMerChant[]
  vouchers         Voucher[]
  tel              String
  status           Boolean            @default(false)
  walletId         String?            @unique
  wallet           Wallet?            @relation(fields: [walletId], references: [id])
  batchTransferLogs BatchTransferLog[]
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String?
  description String?
  apiKey      String    @unique
  merchantId  String?
  createdAt   DateTime  @default(now()) @map(name: "created_at")
  updatedAt   DateTime  @updatedAt @map(name: "updated_at")
  keyHash     String?   @unique
  keyPrefix   String?
  scopes      String[]  @default([])
  expiresAt   DateTime?
  lastUsedAt  DateTime?
  isActive    Boolean   @default(true)
  merchant    Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

// MerchantRefStore - ร้านค้าจริงๆ ที่ไว้อ้างอิงถึงตอน redeem voucher
model MerchantRefStore {
  id          String    @id @default(cuid())
  merchantRef String    @unique // รหัสอ้างอิงร้านค้า (unique identifier)
  name        String // ชื่อร้าน
  category    String? // ประเภทร้าน
  description String? // อธิบาย
  imageUrl    String? // รูปร้าน
  locationUrl String? // URL Google Map
  website     String? // เว็บไซต์ร้าน
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map(name: "created_at")
  updatedAt   DateTime  @updatedAt @map(name: "updated_at")

  @@index([merchantRef])
  @@index([isActive])
  @@index([category])
}

model Transaction {
  id                String           @id @default(cuid())
  txHash            Bytes
  senderAddress     Bytes
  receiverAddress   Bytes
  amount            Int
  eventId           String? // Event ID for tracking redemption events
  createdAt         DateTime         @default(now()) @map(name: "created_at")
  updatedAt         DateTime         @updatedAt @map(name: "updated_at")
  merchant          Merchant?        @relation("TransactionMerchant", fields: [merchantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  merchantId        String?
  merchantRef       String?
  point             Point?           @relation(fields: [pointId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pointId           String?
  transactionType   TransactionType? @relation(fields: [transactionTypeId], references: [id])
  transactionTypeId String?
  voucherCode       VoucherCode?     @relation(fields: [voucherCodeId], references: [id])
  voucherCodeId     String?

  // Unified sender/receiver - ID can be Customer, Merchant, or System
  // Use senderType/receiverType to determine which table to lookup
  senderId     String?          // ID of sender (Customer ID or Merchant ID)
  senderType   ParticipantType? // CUSTOMER | MERCHANT | SYSTEM
  receiverId   String?          // ID of receiver (Customer ID or Merchant ID)
  receiverType ParticipantType? // CUSTOMER | MERCHANT | SYSTEM

  // Asset type: POINT or VOUCHER
  type AssetType?

  // Transaction reference ID for grouping related transactions
  transactionRefId String?

  @@index([voucherCodeId])
  @@index([eventId])
  @@index([type])
  @@index([transactionRefId])
  @@index([senderType])
  @@index([receiverType])
  @@index([senderId])
  @@index([receiverId])
}

model Customer {
  id               String             @id @default(cuid())
  email            String
  firstName        String?
  lastName         String?
  tel              String             @unique
  createdAt        DateTime           @default(now()) @map(name: "created_at")
  updatedAt        DateTime           @updatedAt @map(name: "updated_at")
  customerMerChant CustomerMerChant[]
  customerPoints   CustomerPoint[]

  walletId String? @unique
  wallet   Wallet? @relation(fields: [walletId], references: [id])
}

model CustomerMerChant {
  id         String    @id @default(cuid())
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customerId String?
  merchant   Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  merchantId String?
  createdAt  DateTime? // Track when customer joined merchant (nullable for old data)
}

model CustomerPoint {
  id         String    @id @default(cuid())
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customerId String?
  point      Point?    @relation(fields: [pointId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pointId    String?
  balances   Int       @default(0)

  @@unique([customerId, pointId])
}

model TransactionType {
  id          String        @id @unique
  name        String
  description String
  transaction Transaction[]
}

enum VoucherStatus {
  active
  upcoming
  expired
}

enum VoucherValueType {
  percentage
  cash
  gift
  multiplier
  aispoint
}

// Asset type enum for distinguishing point vs voucher transactions
enum AssetType {
  POINT
  VOUCHER
  THB_TOKEN
}

// Participant type enum for identifying sender/receiver type
enum ParticipantType {
  CUSTOMER
  MERCHANT
  SELLER
  SYSTEM
}

model Voucher {
  id               String           @id
  name             String
  description      String
  status           VoucherStatus
  merchantName     String
  merchantId       String?
  merchant         Merchant?        @relation(fields: [merchantId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  merchantRef      String? // ← Reference ID from merchant system for verification
  sellerMerchantId String? // ← Merchant ID that seller belongs to (set when seller creates voucher)
  tokenId          String?          @unique // ← ERC-1155 Coupon Type ID from smart contract createCouponType()
  valueType        VoucherValueType
  value            Float
  thbPurchasePrice Float? // ← ราคา THB ต่อ unit ที่ Marketer ซื้อจาก Seller
  currency         String?
  startDate        DateTime
  endDate          DateTime
  totalIssued      Int
  totalRedeemed    Int
  imageUrl         String?
  limitPerMember   Int?
  createdAt        DateTime         @default(now()) @map(name: "created_at")
  updatedAt        DateTime         @updatedAt @map(name: "updated_at")
  voucherCodes     VoucherCode[] // ← 1 voucher มีหลาย codes

  @@index([sellerMerchantId])
}

// Listing batch status enum
enum ListingBatchStatus {
  ACTIVE
  SOLD_OUT
  CANCELLED
  EXPIRED
}

// Batch container for grouping multiple voucher listings together
model ListingBatch {
  id                  String             @id @default(cuid())
  sellerWalletAddress String // ← Wallet address of seller who listed
  name                String? // ← Optional batch name (e.g., "Christmas Sale Pack")
  description         String? // ← Optional description
  totalItems          Int // ← Total VoucherCodes in this batch
  soldItems           Int                @default(0) // ← Total sold
  totalValue          Float // ← Sum of all items' total values
  currency            String             @default("THB") // ← Primary currency
  status              ListingBatchStatus @default(ACTIVE)
  createdAt           DateTime           @default(now()) @map(name: "created_at")
  updatedAt           DateTime           @updatedAt @map(name: "updated_at")

  voucherCodes VoucherCode[] // ← VoucherCodes in this batch

  @@index([sellerWalletAddress])
  @@index([status])
  @@index([createdAt])
}

model VoucherCode {
  id             String        @id @default(cuid())
  code           String        @unique // ← Code ที่ไม่ซ้ำกัน
  voucherId      String
  voucher        Voucher       @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  voucherGroupId String? // ← Marketplace listing ID from listCoupon() - each activation batch has unique listingId
  pointsCost     Int // ← ราคาเป็น points
  thbPrice       Float? // ← ราคา THB ที่ Seller ลิส (สำหรับคำนวณมูลค่าที่ซื้อมา)
  pointId        String? // ← Point currency ที่ใช้ซื้อ (FK to Point)
  point          Point?        @relation(fields: [pointId], references: [id], onDelete: SetNull)
  currency       String? // ← Point.symbol (e.g., "GOLD", "SILVER") - denormalized for query performance
  isUsed           Boolean          @default(false)
  usedBy           String? // ← Customer ID ที่ใช้
  usedAt           DateTime?
  currentOwnerId   String? // ← Owner ID (can be Customer, Merchant, or Seller ID)
  currentOwnerType ParticipantType? // ← Type of owner: CUSTOMER, MERCHANT, or SELLER
  transactions     Transaction[] // ← Transaction history
  createdAt      DateTime      @default(now()) @map(name: "created_at")

  // Batch listing reference (optional - for batch listings)
  listingBatchId String? // ← FK to ListingBatch
  listingBatch   ListingBatch? @relation(fields: [listingBatchId], references: [id], onDelete: SetNull)

  @@index([voucherId, isUsed])
  @@index([code])
  @@index([voucherGroupId])
  @@index([currentOwnerId, currentOwnerType])
  @@index([pointId])
  @@index([listingBatchId])
}

model Treasury {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  type          String   @unique // "burner", "reserve", "treasury"
  createdAt     DateTime @default(now()) @map(name: "created_at")
  updatedAt     DateTime @updatedAt @map(name: "updated_at")
}

model TempLinkCreateUser {
  id          String   @id @default(cuid())
  uid         String   @unique
  expire      DateTime
  phoneNumber String
  merchantId  String
  otp         String?
  createdAt   DateTime @default(now()) @map(name: "created_at")
  updatedAt   DateTime @updatedAt @map(name: "updated_at")

  @@index([uid])
  @@index([phoneNumber])
  @@index([merchantId])
  @@index([expire])
}

// AIS Transfer API call log — request/response เก็บเป็น Bytes (blob)
model AisTransferLog {
  id           String   @id @default(cuid())
  transactionID String  // AIS transaction ID ที่ใช้ยิง
  action       String   // "TRANSFER_IN" | "TRANSFER_REVERSE"
  url          String   // Full URL ที่ยิงไป
  requestBody  Bytes    // JSON body แปลงเป็น Buffer
  responseBody Bytes?   // Response JSON เป็น Buffer (nullable กรณี network error)
  httpStatus   Int?     // HTTP status code (nullable กรณี network error)
  success      Boolean  // สำเร็จหรือไม่
  errorMessage String?  // Error message ถ้ามี
  msisdn       String   // เบอร์โทรลูกค้า
  points       Int?     // จำนวน points (เฉพาะ transferIn)
  createdAt    DateTime @default(now()) @map(name: "created_at")

  @@index([transactionID])
  @@index([msisdn])
  @@index([action])
  @@index([createdAt])
}

model BatchTransferLog {
  id              String   @id @default(cuid())
  merchantId      String
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  fileName        String   // เพื่อเก็บชื่อไฟล์หลัก เช่น "rewards_list_june.csv"
  totalRecords    Int      // จำนวนรายการทั้งหมดในไฟล์ เช่น 100
  successfulCount Int      // จำนวนโอนสำเร็จ เช่น 98
  failedCount     Int      // จำนวนโอนล้มเหลว เช่น 2
  status          String   // "SUCCESS" | "FAILED" | "PARTIAL_FAILED"
  details         Json?    // เก็บข้อมูลประวัติย้อนหลังเรียงแถวสำเร็จ/ล้มเหลว (JSON Array) เพื่อความสะดวกในการโหลดข้อมูลขึ้น UI ในคิวรี่เดียว
  technicalLogs   String?  // เก็บ Stack Trace / RPC Error Message แบบ JSON String
  createdAt       DateTime @default(now()) @map(name: "created_at")
  updatedAt       DateTime @updatedAt @map(name: "updated_at")

  @@index([merchantId])
  @@index([createdAt])
}
